---
import ProjectDiagram from './ProjectDiagram.astro';

interface Props {
  id: string;
  href: string;
  title: string;
  summary: string;
  client: string;
  period: string;
  index?: number;
}

const { id, href, title, summary, client, period, index = 0 } = Astro.props;
// 카드에는 고객사 이름만(「네오팜 — 아토팜샵 · …」의 앞부분)
const clientName = client.split(' — ')[0];
---

<article class="case-row" data-reveal style={`--i:${Math.min(index, 5)}`}>
  <a href={href} class="case-link">
    <div class="text">
      <h3 class="title">{title}</h3>
      <p class="summary">{summary}</p>
      <p class="meta">
        <span>{clientName}</span>
        <span class="sep" aria-hidden="true"></span>
        <span class="mono">{period}</span>
      </p>
      <span class="more">
        자세히 보기
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
    <div class="art">
      <ProjectDiagram id={id} />
    </div>
  </a>
</article>

<style>
  .case-row {
    border-top: 1px solid var(--line);
  }

  .case-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 40px;
    align-items: center;
    padding-block: 36px;
    color: var(--text);
  }

  .case-link:hover {
    color: var(--text);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .title {
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: color 0.15s;
  }

  .case-link:hover .title {
    color: var(--accent);
  }

  .summary {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.7;
    max-width: 52ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 13px;
    color: var(--text-3);
  }

  .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--line-2);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-3);
    transition: color 0.15s, gap 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .case-link:hover .more {
    color: var(--accent);
    gap: 10px;
  }

  .art {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background-color: var(--bg-2);
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 18px 18px;
    transition: border-color 0.2s;
  }

  .case-link:hover .art {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  :global(.motion) .case-row:not(.in-view) {
    opacity: 0;
    transform: translateY(16px);
  }

  :global(.motion) .case-row {
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 60ms);
  }

  @media (max-width: 860px) {
    .case-link {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-block: 28px;
    }

    /* 한 단일 때 도식이 화면 폭만큼 커지면 글보다 무거워진다 → 상한을 둔다 */
    .art {
      order: -1;
      width: 100%;
      max-width: 560px;
      padding: 16px;
    }
  }
</style>
