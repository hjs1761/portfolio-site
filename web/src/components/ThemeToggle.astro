---
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="밝은 톤으로 전환">
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M20.2 14.6A8.2 8.2 0 0 1 9.4 3.8a8.2 8.2 0 1 0 10.8 10.8Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script is:inline src="/js/theme-toggle.js" defer></script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .icon-moon {
    display: block;
  }
</style>
