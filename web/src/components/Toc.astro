---
// 긴 본문 옆에 붙는 목차. 넓은 화면에서만 보이고, 읽는 위치의 항목을 표시한다.
interface Item {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  items: Item[];
  label?: string;
}

const { items, label = '이 페이지의 목차' } = Astro.props;
---

<nav class="toc" aria-label={label} data-toc>
  <p class="toc-title">목차</p>
  <ol>
    {
      items.map((i) => (
        <li class:list={['toc-item', { sub: i.depth > 2 }]}>
          <a href={`#${i.slug}`} data-toc-link>
            {i.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  import { mountToc } from '../scripts/toc';

  document.querySelectorAll<HTMLElement>('[data-toc]').forEach(mountToc);
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    max-height: calc(100vh - var(--header-h) - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc-title {
    font-size: 12px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }

  .toc-item a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 1px solid transparent;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-3);
    transition: color 0.15s, border-color 0.15s;
  }

  .toc-item.sub a {
    padding-left: 26px;
    font-size: 13px;
  }

  .toc-item a:hover {
    color: var(--text);
  }

  .toc-item a[aria-current='true'] {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>
